{% comment %}
  Section contract.
  Full-width hero: one background image with the headline over it, bottom-left.
  Designed to sit under the theme's own transparent header on the home page.
  @example
  <!-- Home page, first section. Leave the images empty to use the bundled brand photo. -->
{% endcomment %}

{% render 'aqx-styles' %}

{% liquid
  assign s = section.settings
  assign alt = s.image.alt | default: s.heading | escape
  case s.fallback_image
    when 'story'
      assign fallback = 'aqx-story-workbench.jpg'
    when 'proof'
      assign fallback = 'aqx-proof-macro.jpg'
    else
      assign fallback = 'aqx-hero-desktop.jpg'
  endcase
%}

<div
  class="aqx aqx-hero aqx-hero--{{ s.content_position }}"
  style="--aqx-hero-min: {{ s.min_height }}svh; --aqx-hero-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="aqx-hero__media">
    <picture>
      {%- if s.image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
        >
      {%- elsif s.image == blank and s.fallback_image == 'hero' -%}
        <source media="(max-width: 749px)" srcset="{{ 'aqx-hero-mobile.jpg' | asset_url }}">
      {%- endif -%}

      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 2400
          | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: alt
        }}
      {%- else -%}
        <img
          src="{{ fallback | asset_img_url: '2000x' }}"
          srcset="{{ fallback | asset_img_url: '1100x' }} 1100w, {{ fallback | asset_img_url: '2000x' }} 2000w, {{ fallback | asset_img_url: '2560x' }} 2560w"
          sizes="100vw"
          width="2560"
          height="1440"
          loading="eager"
          fetchpriority="high"
          alt="{{ s.heading | escape }}"
        >
      {%- endif -%}
    </picture>
  </div>

  <div class="aqx-container aqx-hero__inner">
    <div class="aqx-hero__copy">
      {%- if s.heading != blank -%}
        <h1 class="aqx-hero__heading h1">{{ s.heading | escape }}</h1>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <p class="aqx-hero__sub">{{ s.subheading | escape }}</p>
      {%- endif -%}

      {%- if s.button_label != blank or s.link_label != blank -%}
        <div class="aqx-hero__actions">
          {%- if s.button_label != blank -%}
            <a class="button aqx-hero__button" href="{{ s.button_link | default: routes.all_products_collection_url }}">
              {{- s.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="aqx-text-link aqx-hero__link" href="{{ s.link_url | default: routes.all_products_collection_url }}">
              {{- s.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .aqx-hero {
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, var(--aqx-hero-min, 88svh), 58rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--aqx-obsidian);
    color: #fff;
  }

  .aqx-hero--center {
    align-items: center;
  }

  .aqx-hero__media,
  .aqx-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aqx-hero__media {
    z-index: -2;
  }

  .aqx-hero__media img {
    object-position: 62% 50%;
  }

  /* Dark at the top for the navigation, dark at the bottom-left for the headline */
  .aqx-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(5 8 13 / 0.6) 0%, rgb(5 8 13 / 0) 24%),
      linear-gradient(
        to top,
        rgb(5 8 13 / calc(var(--aqx-hero-overlay, 0.9) + 0.06)) 0%,
        rgb(5 8 13 / calc(var(--aqx-hero-overlay, 0.9) * 0.78)) 34%,
        rgb(5 8 13 / 0.1) 72%
      );
  }

  .aqx-hero__inner {
    padding-block: calc(var(--header-height, 60px) + 3rem) 2.75rem;
  }

  .aqx-hero__heading.h1 {
    max-width: 12ch;
    margin: 0;
    color: #fff;
    font-size: clamp(2.6rem, 10.5vw, 5rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .aqx-hero__sub {
    max-width: 44ch;
    margin: 1.1rem 0 0;
    color: var(--aqx-silver);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .aqx-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .aqx-hero__button.button {
    width: 100%;
    min-height: 3.4rem;
    font-size: 1rem;
  }

  .aqx-hero__link {
    padding-block: 0.4rem;
    color: #fff;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .aqx-hero::after {
      background: linear-gradient(to bottom, rgb(5 8 13 / 0.58) 0%, rgb(5 8 13 / 0) 22%),
        linear-gradient(
          75deg,
          rgb(5 8 13 / calc(var(--aqx-hero-overlay, 0.9) + 0.05)) 0%,
          rgb(5 8 13 / calc(var(--aqx-hero-overlay, 0.9) * 0.76)) 34%,
          rgb(5 8 13 / 0.06) 66%
        );
    }

    .aqx-hero__inner {
      padding-block: calc(var(--header-height, 60px) + 4rem) 5.5rem;
    }

    .aqx-hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
    }

    .aqx-hero__button.button {
      width: auto;
      padding-inline: 1.75rem;
    }

    .aqx-hero__link {
      text-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AquaBladeX hero",
  "tag": "section",
  "class": "aqx-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Leave empty to use the bundled brand photo. Best at 2400 x 1350 px, with the bottom-left kept dark for the text."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image on phones",
      "info": "Optional portrait crop, about 1200 x 1800 px."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Bundled photo",
      "options": [
        { "value": "hero", "label": "Towel on bonnet" },
        { "value": "story", "label": "Folding the towel" },
        { "value": "proof", "label": "Water beads close-up" }
      ],
      "default": "hero"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay behind the text",
      "min": 40,
      "max": 94,
      "step": 2,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Height",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 88
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text position",
      "options": [
        { "value": "bottom", "label": "Bottom left" },
        { "value": "center", "label": "Middle left" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dry your car in minutes."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting text",
      "default": "No streaks. No scratches. Thick microfiber that absorbs water instantly and stays gentle on your paint."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop DryMaster towels"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Text link label",
      "default": "Which towel fits my car?"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Text link"
    }
  ],
  "presets": [
    {
      "name": "AquaBladeX hero"
    }
  ]
}
{% endschema %}
