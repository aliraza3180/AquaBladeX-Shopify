{% comment %}
  Section contract.
  Side-by-side product chooser. Each card shows a photo, who the product is for and its
  package prices read live from the product's variants, with a button to the product page.
  Buying still happens through the theme's own add-to-cart on the product page.
  @example
  <!-- Add one "Product" block per towel and pick the product in each block. -->
{% endcomment %}

{% render 'aqx-styles' %}
{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="aqx aqx-chooser aqx-pad color-custom-{{ section.id }}">
  <div class="aqx-container">
    <div class="aqx-center">
      {%- if section.settings.heading != blank -%}
        <h2 class="aqx-heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="aqx-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="aqx-chooser__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign title = block.settings.title | default: product.title
          assign image = block.settings.image | default: product.featured_image
          assign fallback = blank
          if block.settings.image == blank
            case block.settings.bundled_photo
              when '1300'
                assign fallback = 'aqx-drymaster-1300-card.jpg'
              when '1400'
                assign fallback = 'aqx-drymaster-1400-card.jpg'
            endcase
          endif
        -%}
        <article class="aqx-chooser__card" {{ block.shopify_attributes }}>
          <div class="aqx-chooser__media">
            {%- if fallback != blank -%}
              <img
                src="{{ fallback | asset_img_url: '1200x' }}"
                srcset="{{ fallback | asset_img_url: '700x' }} 700w, {{ fallback | asset_img_url: '1200x' }} 1200w, {{ fallback | asset_img_url: '1600x' }} 1600w"
                sizes="(min-width: 750px) 45vw, 100vw"
                width="1600"
                height="1000"
                loading="lazy"
                alt="{{ title | escape }}"
              >
            {%- elsif image != blank -%}
              {{
                image
                | image_url: width: 1600
                | image_tag: widths: '500, 800, 1200, 1600', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy', alt: title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'aqx-chooser__placeholder' }}
            {%- endif -%}
          </div>

          <div class="aqx-chooser__body">
            <h3 class="aqx-chooser__title h3">{{ title | default: 'Choose a product' | escape }}</h3>
            {%- if block.settings.tagline != blank -%}
              <p class="aqx-chooser__tagline">{{ block.settings.tagline | escape }}</p>
            {%- endif -%}

            {%- if product != blank -%}
              <ul class="aqx-chooser__packs" role="list">
                {%- for variant in product.variants limit: 4 -%}
                  {%- liquid
                    # Variant titles look like "2 Towels – Save 10%": the part after the dash becomes a tag
                    assign parts = variant.title | split: ' – '
                    assign pack_name = parts | first
                    if product.has_only_default_variant
                      assign pack_name = block.settings.single_price_label
                    endif
                  -%}
                  <li class="aqx-chooser__pack">
                    <span class="aqx-chooser__pack-name">
                      {{ pack_name | escape }}
                      {%- if parts.size > 1 -%}
                        <span class="aqx-tag">{{ parts | last | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="aqx-chooser__price">{{ variant.price | money }}</span>
                  </li>
                {%- endfor -%}
              </ul>

              <a class="button aqx-chooser__button" href="{{ product.url }}">
                {{- block.settings.button_label | default: title | escape -}}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .aqx-chooser__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .aqx-chooser__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--aqx-cloud);
    border-radius: var(--aqx-radius);
    background: #fff;
    color: var(--aqx-ink);
  }

  .aqx-chooser__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #eef2f6;
  }

  .aqx-chooser__media :is(img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aqx-chooser__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.4rem 1.25rem 1.5rem;
  }

  .aqx-chooser__title.h3 {
    margin: 0;
    color: var(--aqx-ink);
    font-size: 1.5rem;
  }

  .aqx-chooser__tagline {
    margin: 0.3rem 0 0;
    color: var(--aqx-slate);
  }

  .aqx-chooser__packs {
    flex: 1;
    margin: 1.1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--aqx-cloud);
    list-style: none;
  }

  .aqx-chooser__pack {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--aqx-cloud);
  }

  .aqx-chooser__pack-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .aqx-chooser__price {
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .aqx-chooser__button.button {
    width: 100%;
    min-height: 3.4rem;
    margin-top: 1.4rem;
    font-size: 1rem;
  }

  @media screen and (min-width: 750px) {
    .aqx-chooser__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
      margin-top: 3rem;
    }

    .aqx-chooser__body {
      padding: 1.75rem 2rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AquaBladeX chooser",
  "tag": "section",
  "class": "aqx-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two weights. Pick by the size of your car."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting text",
      "default": "Both dry without streaks or scratches. The 1400 is thicker and covers larger areas faster."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the product title."
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Who it is for",
          "default": "For compact and mid-size cars. Easy to handle."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Leave empty to use the bundled photo or the product's first image."
        },
        {
          "type": "select",
          "id": "bundled_photo",
          "label": "Bundled photo",
          "options": [
            { "value": "none", "label": "None (use product image)" },
            { "value": "1300", "label": "DryMaster 1300 on bonnet" },
            { "value": "1400", "label": "DryMaster 1400 on bonnet" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "single_price_label",
          "label": "Price label for products without packages",
          "default": "Price"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Choose this towel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AquaBladeX chooser",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
