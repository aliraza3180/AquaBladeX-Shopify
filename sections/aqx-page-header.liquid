{% comment %}
  Section contract.
  Compact dark page header with the page title over an optional photo.
  On collection pages it can read the title, description and product count from the collection.
  @example
  <!-- First section on the collection, collection list and contact pages. -->
{% endcomment %}

{% render 'aqx-styles' %}

{% liquid
  assign s = section.settings
  assign heading = s.heading
  assign text = s.text
  assign count = blank

  if s.use_page_content
    if collection != blank
      assign heading = collection.title
      assign text = collection.description | strip_html | strip
      assign count = collection.products_count
    elsif page != blank
      assign heading = page.title
    endif
  endif

  assign image = s.image
  if image == blank and s.use_page_content and collection.image != blank
    assign image = collection.image
  endif

  assign fallback = blank
  case s.bundled_photo
    when 'proof'
      assign fallback = 'aqx-proof-macro.jpg'
    when 'hero'
      assign fallback = 'aqx-hero-desktop.jpg'
    when 'story'
      assign fallback = 'aqx-story-workbench.jpg'
  endcase
%}

<div class="aqx aqx-page-header aqx-page-header--{{ s.size }}">
  {%- if image != blank or fallback != blank -%}
    <div class="aqx-page-header__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 2400
          | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ''
        }}
      {%- else -%}
        <img
          src="{{ fallback | asset_img_url: '2000x' }}"
          srcset="{{ fallback | asset_img_url: '1100x' }} 1100w, {{ fallback | asset_img_url: '2000x' }} 2000w"
          sizes="100vw"
          width="2560"
          height="1440"
          loading="eager"
          fetchpriority="high"
          alt=""
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="aqx-container aqx-page-header__inner">
    {%- if heading != blank -%}
      <h1 class="aqx-page-header__heading h1">{{ heading | escape }}</h1>
    {%- endif -%}
    {%- if text != blank -%}
      <p class="aqx-page-header__text">{{ text | escape }}</p>
    {%- endif -%}
    {%- if s.show_count and count != blank -%}
      <p class="aqx-page-header__count">
        {{- count }}
        {% if count == 1 %}{{ s.count_label_one | escape }}{% else %}{{ s.count_label_many | escape }}{% endif -%}
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .aqx-page-header {
    display: flex;
    align-items: flex-end;
    min-height: 15rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--aqx-obsidian);
    color: #fff;
  }

  .aqx-page-header--medium {
    min-height: 21rem;
  }

  .aqx-page-header__media,
  .aqx-page-header__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aqx-page-header__media {
    z-index: -2;
  }

  .aqx-page-header::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(78deg, rgb(5 8 13 / 0.94) 0%, rgb(5 8 13 / 0.78) 42%, rgb(5 8 13 / 0.35) 100%);
  }

  .aqx-page-header__inner {
    padding-block: 3rem 2.25rem;
  }

  .aqx-page-header__heading.h1 {
    max-width: 18ch;
    margin: 0;
    color: #fff;
    font-size: clamp(2.2rem, 7vw, 3.75rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .aqx-page-header__text {
    max-width: 58ch;
    margin: 0.9rem 0 0;
    color: var(--aqx-silver);
    font-size: 1.0625rem;
  }

  .aqx-page-header__count {
    display: inline-block;
    margin: 1.1rem 0 0;
    padding: 0.25rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .aqx-page-header {
      min-height: 18rem;
    }

    .aqx-page-header--medium {
      min-height: 26rem;
    }

    .aqx-page-header__inner {
      padding-block: 4.5rem 3.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AquaBladeX page header",
  "tag": "section",
  "class": "aqx-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_page_content",
      "label": "Use the collection's or page's own title and description",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Used when the option above is off."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the number of products on collection pages",
      "default": true
    },
    {
      "type": "text",
      "id": "count_label_one",
      "label": "Count label, one product",
      "default": "product"
    },
    {
      "type": "text",
      "id": "count_label_many",
      "label": "Count label, several products",
      "default": "products"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Leave empty to use the collection image or a bundled brand photo."
    },
    {
      "type": "select",
      "id": "bundled_photo",
      "label": "Bundled photo",
      "options": [
        { "value": "none", "label": "None (plain dark)" },
        { "value": "proof", "label": "Water beads close-up" },
        { "value": "hero", "label": "Towel on bonnet" },
        { "value": "story", "label": "Folding the towel" }
      ],
      "default": "proof"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Height",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "compact"
    }
  ],
  "presets": [
    {
      "name": "AquaBladeX page header"
    }
  ]
}
{% endschema %}
