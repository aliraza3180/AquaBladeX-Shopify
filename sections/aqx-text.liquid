{% comment %}
  Section contract.
  A text section with two layouts: "Split" puts the heading on the left and the text on
  the right; "Statement" sets one large sentence with an optional button.
  Used on the About and Contact pages.
  @example
  <!-- Pick the layout, then fill in the heading and text. -->
{% endcomment %}

{% render 'aqx-styles' %}
{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- liquid
  assign s = section.settings
-%}

<div class="aqx aqx-text aqx-text--{{ s.layout }} aqx-pad color-custom-{{ section.id }}">
  {%- if s.layout == 'statement' -%}
    <div class="aqx-container">
      {%- if s.heading != blank -%}
        <p class="aqx-text__statement">{{ s.heading | escape }}</p>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="aqx-text__body rte">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="button aqx-text__button" href="{{ s.button_link | default: routes.all_products_collection_url }}">
          {{- s.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="aqx-container aqx-split">
      <div>
        {%- if s.heading != blank -%}
          <h2 class="aqx-heading h2">{{ s.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div>
        {%- if s.text != blank -%}
          <div class="aqx-text__body rte">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="button aqx-text__button" href="{{ s.button_link | default: routes.all_products_collection_url }}">
            {{- s.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .aqx-text__statement {
    max-width: 24ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 5.6vw, 2.9rem);
    font-weight: var(--font-heading--weight, 800);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .aqx-text__body {
    max-width: 62ch;
    color: rgb(var(--color-foreground-rgb) / 0.74);
    font-size: 1.0625rem;
  }

  .aqx-text--statement .aqx-text__body {
    margin-top: 1.1rem;
  }

  .aqx-text__body > :first-child {
    margin-top: 0;
  }

  .aqx-text__body > :last-child {
    margin-bottom: 0;
  }

  .aqx-text__body a {
    color: inherit;
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .aqx-text__button.button {
    min-height: 3.4rem;
    margin-top: 1.75rem;
    padding-inline: 1.75rem;
    font-size: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AquaBladeX text",
  "tag": "section",
  "class": "aqx-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Split (heading left, text right)" },
        { "value": "statement", "label": "Statement (one large sentence)" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why we started"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "AquaBladeX text"
    }
  ]
}
{% endschema %}
